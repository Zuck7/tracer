# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://tracer-app:<password>@<cluster-host>/tracer?retryWrites=true&w=majority
LLM_API_KEY=

# Lease owner. Give each laptop its own (worker-a, worker-b, worker-c). Keep it the same
# across a crash and restart, so the restarted agent reclaims its own lease at once.
WORKER_ID=worker-a

# Optional: port for the live log (default 8000). Change it if your browser has another
# project cached on localhost:8000.
# LIVE_LOG_PORT=8090

# Voice assistant on the dashboard (optional). Key from elevenlabs.io → API keys.
# Run `python -m scripts.setup_voice_agent` once; it prints the agent ID to paste here.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional narrator voice (default: a stock ElevenLabs voice). The narrator needs only the key.
# ELEVENLABS_VOICE_ID=
